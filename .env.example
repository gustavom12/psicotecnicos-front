# Copiar a .env.local y ajustar valores.

# Email(s) que siempre se agregan como invitado en el link pre-rellenado
# de Google Calendar al crear una entrevista. Acepta múltiples separados por coma.
# Debe estar prefijado con NEXT_PUBLIC_ para ser accesible desde el cliente.
NEXT_PUBLIC_DEFAULT_INVITEE_EMAILS=
